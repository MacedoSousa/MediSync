# Copie para .env fora do controle de versão e substitua todos os valores de exemplo.
MYSQL_DATABASE=medsync
MYSQL_USER=medsync_app
MYSQL_PASSWORD=troque-por-uma-senha-longa-e-unica
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-longa-e-unica
MYSQL_PORT=3306
API_PORT=3000
WEB_PORT=8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Chave de 32 bytes em Base64. Nunca reutilize uma chave de outro ambiente.
MEDSYNC_FIELD_ENCRYPTION_KEY=substitua-por-chave-base64-de-32-bytes

# Credenciais OAuth são obrigatórias para login em ambiente externo.
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=
